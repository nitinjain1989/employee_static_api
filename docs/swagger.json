{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/employees/{id}": {
            "patch": {
                "description": "Updates employee details by ID. Supports partial updates. Maximum 3 mobile numbers allowed. Returns conflict if version mismatch (last-write handling).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "employees"
                ],
                "summary": "Update an existing employee",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Employee ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Employee update payload (max 3 mobiles allowed)",
                        "name": "employee",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.UpdateEmployeeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Employee updated successfully",
                        "schema": {
                            "$ref": "#/definitions/dto.EmployeeDetailResponse"
                        }
                    },
                    "400": {
                        "description": "Missing ID, invalid request body, or validation error",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    },
                    "404": {
                        "description": "Employee not found",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict error (e.g., version mismatch)",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    }
                }
            }
        },
        "/employees": {
            "get": {
                "description": "Fetch employees with pagination, search, and filters",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "employees"
                ],
                "summary": "Get employees with filters",
                "parameters": [
                    {
                        "type": "integer",
                        "example": 10,
                        "description": "Number of records to fetch",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "example": 0,
                        "description": "Number of records to skip",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Search keyword",
                        "name": "search",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by status",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Comma-separated designations",
                        "name": "designation",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Comma-separated departments",
                        "name": "department",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.EmployeeListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a new employee with basic details and up to 3 mobile numbers. Validates required fields before creation.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "employees"
                ],
                "summary": "Create a new employee",
                "parameters": [
                    {
                        "description": "Employee payload (max 3 mobiles allowed)",
                        "name": "employee",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateEmployeeRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Employee created successfully",
                        "schema": {
                            "$ref": "#/definitions/dto.EmployeeDetailResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request body, missing name, or too many mobiles",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    }
                }
            }
        },
        "/employees/filters": {
            "get": {
                "description": "Fetch available filter values like designation, department, status, etc.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "employees"
                ],
                "summary": "Get employee filter options",
                "responses": {
                    "200": {
                        "description": "Filter data fetched successfully",
                        "schema": {
                            "$ref": "#/definitions/dto.EmployeeFiltersResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    }
                }
            }
        },
        "/employees/{id}": {
            "get": {
                "description": "Fetch a single employee by its unique ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "employees"
                ],
                "summary": "Get employee by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Employee ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.EmployeeDetailResponse"
                        }
                    },
                    "400": {
                        "description": "Missing or invalid ID",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Delete an employee by its ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "employees"
                ],
                "summary": "Delete an employee",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Employee ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Employee deleted successfully",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Missing employee ID",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/response.MessageResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.CreateEmployeeRequest": {
            "type": "object",
            "required": [
                "email",
                "name"
            ],
            "properties": {
                "city": {
                    "type": "string",
                    "example": "Noida"
                },
                "country": {
                    "type": "string",
                    "example": "India"
                },
                "department": {
                    "type": "string",
                    "example": "Engineering"
                },
                "designation": {
                    "type": "string",
                    "example": "iOS Engineer"
                },
                "email": {
                    "type": "string",
                    "example": "nitin@test.com"
                },
                "img_url": {
                    "type": "string",
                    "example": "https://image.com/profile.jpg"
                },
                "is_active": {
                    "type": "boolean"
                },
                "joining_date": {
                    "type": "string",
                    "example": "2024-01-01"
                },
                "mobiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.MobileRequest"
                    }
                },
                "name": {
                    "type": "string",
                    "example": "Nitin Jain"
                }
            }
        },
        "dto.EmployeeDetailResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/dto.EmployeeResponse"
                },
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "dto.EmployeeFilters": {
            "type": "object",
            "properties": {
                "departments": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "designations": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "mobile_types": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.FilterOption"
                    }
                },
                "statuses": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.FilterOption"
                    }
                }
            }
        },
        "dto.EmployeeFiltersResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/dto.EmployeeFilters"
                },
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "dto.EmployeeListResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.EmployeeResponse"
                    }
                },
                "message": {
                    "type": "string"
                },
                "meta": {
                    "$ref": "#/definitions/dto.Meta"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "dto.EmployeeResponse": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "deleted_at": {
                    "type": "string"
                },
                "department": {
                    "type": "string"
                },
                "designation": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "description": "optional: keep or remove",
                    "type": "string"
                },
                "img_url": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "joining_date": {
                    "type": "string"
                },
                "mobiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.MobileResponse"
                    }
                },
                "name": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "version": {
                    "type": "integer"
                }
            }
        },
        "dto.FilterOption": {
            "type": "object",
            "properties": {
                "label": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            }
        },
        "dto.Meta": {
            "type": "object",
            "properties": {
                "has_next_page": {
                    "type": "boolean"
                },
                "page": {
                    "type": "integer"
                },
                "page_size": {
                    "type": "integer"
                },
                "total_count": {
                    "type": "integer"
                }
            }
        },
        "dto.MobileRequest": {
            "type": "object",
            "properties": {
                "number": {
                    "type": "string",
                    "example": "9876543210"
                },
                "type": {
                    "type": "string",
                    "example": "home"
                }
            }
        },
        "dto.MobileResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "number": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "dto.UpdateEmployeeRequest": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "country": {
                    "type": "string"
                },
                "department": {
                    "type": "string"
                },
                "designation": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "img_url": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "joining_date": {
                    "type": "string"
                },
                "mobiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.MobileRequest"
                    }
                },
                "name": {
                    "type": "string"
                },
                "version": {
                    "description": "🔥 required",
                    "type": "integer"
                }
            }
        },
        "response.MessageResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        }
    }
}